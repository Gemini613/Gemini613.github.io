            max-width: 800px;
            margin: 0 auto;
        }
        .article-container {
            background: rgba(255, 255, 255, 0.6);
            padding: 40px;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.03);
            margin-top: 40px;
        }
        h1 {
            font-weight: 300;
            letter-spacing: 0.05em;
            border-bottom: 1px solid #ebebeb;
            padding-bottom: 20px;
            margin-bottom: 30px;
            text-align: center;
            color: #4a4a4a;
        }
        p {
            margin-bottom: 20px;
            font-size: 1.1rem;
            text-align: justify; /* 两端对齐，让长段落更整齐 */
            color: #4a4a4a;
        }
        /* 首段特殊处理：稍微大一点，加一点强调 */
